# Copy to .env and change the values. .env is gitignored; only this file is committed.
# Every credential the Compose file uses comes from here through ${...} (ASG-DEVOPS-023).
# The values below are placeholders for local development, not real credentials.

# ---- PostgreSQL ------------------------------------------------------------------
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=civicpulse

# ---- Backend -----------------------------------------------------------------------
# compose.yaml builds DATABASE_URL and REDIS_URL from the values above and the service names
# (database, cache) on the internal network: no localhost between services.
LOG_LEVEL=INFO
# rules | simulated | llm | ollama. For ollama, also use Compose's offline profile.
TRIAGE_PROVIDER=rules
GROQ_API_KEY=
OLLAMA_MODEL=gemma3:1b

# ---- Published port on the host ----------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=8080
