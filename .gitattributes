# Development happens on Windows (core.autocrlf=true) but every runtime is Linux.
# A CRLF in a Dockerfile, entrypoint or shell script fails at container start
# ("exec format error" / "\r: command not found"), so text is normalised to LF.
* text=auto eol=lf

# The assignment source and evidence must never be altered by line-ending logic.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.gz binary
*.zip binary

# Append-only log: when two branches each add a row at the end of docs/AI-USAGE.md, keep both rows
# instead of raising a conflict. Never edit an existing row on two branches at once (that would
# duplicate it). Applies to local merges and rebases; always rebase locally before merging on GitHub.
docs/AI-USAGE.md merge=union
